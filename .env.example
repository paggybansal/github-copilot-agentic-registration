# Configuration template only.
# Copy to .env for local development, but never commit .env.

# Used to sign Flask sessions and CSRF tokens.
FLASK_SECRET_KEY=

# Local SQLite database path.
REGISTRATION_DATABASE=instance/registration.db

# FLASK_DEBUG is intentionally NOT read by this application.
# DEBUG is hardcoded to False in config.py per ADD-1 (DR-1) to prevent any
# environment-variable path from enabling debug/traceback exposure.
FLASK_DEBUG=false